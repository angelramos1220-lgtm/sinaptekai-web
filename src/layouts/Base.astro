---
// Layout base de todas las páginas: <head> con metas por página, fuentes, datos
// estructurados, medición y estilos globales.
import '../styles/global.css';
import '../styles/componentes.css';
import { negocio } from '../data/negocio';
import { servicios } from '../data/servicios';
import { textosPaginas as tp } from '../data/textosPaginas';
import { rutaMarkdown } from '../lib/rutas';
import manropeUrl from '../assets/fonts/manrope-latin.woff2?url';

export interface Props {
  /** <title> completo de la página. */
  titulo: string;
  descripcion: string;
  /** Ruta limpia de la página: con barra inicial, sin .html y sin barra final ("/" para la portada). */
  ruta: string;
  /** Texto alternativo de la imagen para redes. */
  ogImagenAlt?: string;
  noindex?: boolean;
  /** Datos estructurados propios de la página (Service, FAQPage, BreadcrumbList…). */
  jsonLd?: object[];
  /** La página tiene versión Markdown (src/lib/markdown.ts): se anuncia en el <head>. */
  markdown?: boolean;
}

const { titulo, descripcion, ruta, ogImagenAlt, noindex = false, jsonLd = [], markdown = false } = Astro.props;
// Canonical absoluto a la URL limpia: /privacidad.html y /privacidad apuntan a /privacidad.
const canonical = new URL(ruta, negocio.url).href;
const ogImagen = `${negocio.url}/assets/og-image.jpg`;
const altImagen = ogImagenAlt ?? 'SynaptekAI: automatización e inteligencia artificial para negocios en Perú';

// Datos estructurados del negocio: van en todas las páginas, en el HTML del servidor.
const organizacion = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  '@id': `${negocio.url}/#organizacion`,
  name: negocio.nombre,
  url: `${negocio.url}/`,
  logo: `${negocio.url}/assets/favicon-512x512.png`,
  description: negocio.descripcion,
  email: negocio.correo,
  telephone: `+${negocio.whatsapp.numero}`,
  address: {
    '@type': 'PostalAddress',
    addressLocality: negocio.ubicacion.ciudad,
    addressCountry: negocio.ubicacion.pais,
  },
  areaServed: { '@type': 'Country', name: negocio.ubicacion.paisNombre },
  sameAs: [negocio.redes.facebook, negocio.redes.instagram],
  hasOfferCatalog: {
    '@type': 'OfferCatalog',
    name: 'Servicios principales',
    itemListElement: servicios.map((s) => ({
      '@type': 'Offer',
      itemOffered: { '@type': 'Service', name: s.titulo, description: s.descripcion },
    })),
  },
};
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{titulo}</title>
    <meta name="description" content={descripcion}>
    <link rel="canonical" href={canonical}>
    {noindex && <meta name="robots" content="noindex">}
    {markdown && <link rel="alternate" type="text/markdown" href={rutaMarkdown(ruta)}>}

    <meta property="og:type" content="website">
    <meta property="og:url" content={canonical}>
    <meta property="og:title" content={titulo}>
    <meta property="og:description" content={descripcion}>
    <meta property="og:image" content={ogImagen}>
    <meta property="og:image:width" content="1200">
    <meta property="og:image:height" content="630">
    <meta property="og:image:alt" content={altImagen}>
    <meta property="og:locale" content="es_PE">
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content={titulo}>
    <meta name="twitter:description" content={descripcion}>
    <meta name="twitter:image" content={ogImagen}>

    <link rel="icon" href="/assets/favicon.ico" sizes="any">
    <link rel="icon" type="image/png" sizes="512x512" href="/assets/favicon-512x512.png">
    <link rel="icon" type="image/png" sizes="192x192" href="/assets/favicon-192x192.png">
    <link rel="icon" type="image/png" sizes="96x96" href="/assets/favicon-96x96.png">
    <link rel="icon" type="image/png" sizes="48x48" href="/assets/favicon-48x48.png">
    <link rel="apple-touch-icon" href="/assets/apple-touch-icon.png">

    <!-- La fuente del texto se pide de inmediato: es la del titular. -->
    <link rel="preload" href={manropeUrl} as="font" type="font/woff2" crossorigin>

    <script type="application/ld+json" set:html={JSON.stringify(organizacion)} />
    {jsonLd.map((dato) => <script type="application/ld+json" set:html={JSON.stringify(dato)} />)}

    <!-- Antes de dibujar la página:
         1. Producción es SOLO synaptekai.tech y www.synaptekai.tech (negocio.dominiosProduccion).
            Solo ahí se carga Google Analytics 4, y con retraso: la configuración queda en la
            cola (dataLayer) desde el principio, pero la librería gtag.js (177 kB) se pide
            recién al primer gesto del visitante (scroll, toque, clic, tecla) o, si no hace
            nada, 3 segundos después de que la página termina de cargar. Así no compite con
            el dibujado de la página. Los eventos que ocurran antes (un clic en WhatsApp)
            esperan en la cola y se envían cuando la librería llega: no se pierden.
         2. En cualquier otro dominio (el sitio de prueba, un dominio de Easypanel, localhost)
            la página va en modo de prueba: muestra la franja de aviso y escribe los eventos
            en la consola. nginx aplica la misma regla para el noindex y robots.txt.
         3. Si se entra con un ancla (/#paquetes) y el visitante no pidió menos movimiento,
            se guarda y se quita de la URL para que el navegador no salte de golpe:
            src/scripts/ancla.ts hace después el desplazamiento suave. -->
    <script is:inline define:vars={{ ga4: negocio.ga4, dominios: negocio.dominiosProduccion }}>
      window.dataLayer = window.dataLayer || [];
      function gtag() { dataLayer.push(arguments); }
      window.gtag = gtag;
      var produccion = dominios.indexOf(location.hostname) !== -1;
      window.__ga4Activo = produccion;
      if (produccion) {
        gtag('js', new Date());
        gtag('config', ga4);
        var gestos = ['scroll', 'pointerdown', 'touchstart', 'keydown'];
        var pedido = false;
        var cargarGa = function () {
          if (pedido) return;
          pedido = true;
          gestos.forEach(function (g) { window.removeEventListener(g, cargarGa, true); });
          var s = document.createElement('script');
          s.async = true;
          s.src = 'https://www.googletagmanager.com/gtag/js?id=' + ga4;
          document.head.appendChild(s);
        };
        gestos.forEach(function (g) { window.addEventListener(g, cargarGa, { capture: true, passive: true }); });
        var tope = function () { setTimeout(cargarGa, 3000); };
        if (document.readyState === 'complete') tope(); else window.addEventListener('load', tope);
        // Respaldo: si la página nunca termina de cargar (un recurso colgado), se pide igual.
        setTimeout(cargarGa, 10000);
      }
      if (!produccion) document.documentElement.classList.add('sitio-prueba');
      if (location.hash.length > 1 && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        window.__anclaInicial = location.hash;
        history.replaceState(null, '', location.pathname + location.search);
      }
    </script>
  </head>
  <body>
    <div class="franja-prueba" role="status">{tp.franjaPrueba}</div>
    <div style="background:#0B0F19; color:#F1F5F9; min-height:100vh;">
      <slot />
    </div>
    <slot name="flotantes" />

    <script>
      // Comportamiento común a todas las páginas.
      import { iniciarAparicion } from '../scripts/aparicion.js';
      import { iniciarTarjetas } from '../scripts/tarjetas.js';
      import { iniciarMedicion } from '../scripts/medicion';
      import { iniciarAncla } from '../scripts/ancla';
      iniciarAparicion();
      iniciarTarjetas();
      iniciarMedicion();
      iniciarAncla();
    </script>
  </body>
</html>
