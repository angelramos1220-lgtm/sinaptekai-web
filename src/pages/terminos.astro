---
// /terminos: mismo contenido de siempre, con el layout nuevo.
// IMPORTANTE: esta URL está registrada en la pantalla de consentimiento OAuth de
// Google. Debe responder 200 en /terminos, sin redirección. El texto legal vive en
// src/legal/terminos.html y no se modifica desde aquí.
import Pagina from '../layouts/Pagina.astro';
import '../styles/legal.css';
import contenido from '../legal/terminos.html?raw';
import { textos as t } from '../data/textos';
import { textosPaginas as tp } from '../data/textosPaginas';
import { migasJsonLd } from '../lib/datosEstructurados';

const jsonLd = [migasJsonLd([{ texto: tp.migasInicio, ruta: '/' }, { texto: t.footTerminos, ruta: '/terminos' }])];
---

<Pagina titulo={tp.legal.terminosSeo} descripcion={tp.legal.terminosDescripcion} ruta="/terminos" chat={false} jsonLd={jsonLd}>
  <div data-origen="terminos" set:html={contenido} />
</Pagina>
