---
// Página de gracias del checklist. Se publica como /gracias.html (y /gracias):
// el formulario redirige a /gracias.html, así que esa URL no puede cambiar.
// Mismos textos que la página anterior; no se indexa.
import Pagina from '../layouts/Pagina.astro';
import BotonWhatsApp from '../components/BotonWhatsApp.astro';
import { integraciones } from '../data/negocio';
import { textosPaginas as tp } from '../data/textosPaginas';

const g = tp.gracias;
---

<Pagina titulo={g.seoTitulo} descripcion={g.seoDescripcion} ruta="/gracias" chat={false} noindex>
  <section class="pagina-simple">
    <div class="contenedor">
      <h1 class="titulo-pagina"><span class="titulo-pagina__acento">{g.titulo}</span></h1>
      <a class="boton boton--primario" href={integraciones.pdfChecklist} download={g.nombreArchivo}>
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3v13"></path><path d="M6 11l6 6 6-6"></path><path d="M4 21h16"></path></svg>
        {g.descargar}
      </a>
      <p class="texto texto--pequeno">{g.tambienCorreo}</p>
      <p class="texto">{g.revisaCorreo}</p>
      <p class="texto">{g.avanzar}</p>
      <BotonWhatsApp mensaje={g.mensajeWhatsApp} origen={g.origen} texto={g.botonWhatsApp} />
      <a class="enlace enlace--tenue" href="/">{g.volver}</a>
    </div>
  </section>
</Pagina>
