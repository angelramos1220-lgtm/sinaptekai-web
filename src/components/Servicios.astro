---
// Sección "Servicios": las 6 tarjetas de los servicios principales.
// Datos: src/data/servicios.ts. Títulos de sección: src/data/textos.ts.
import { textos as t } from '../data/textos';
import { servicios } from '../data/servicios';

const estiloTarjeta = 'border-radius:18px; padding:32px; display:flex; flex-direction:column; gap:14px; box-sizing:border-box;';
// El degradado del ícono alterna de dirección entre tarjetas vecinas.
const fondoIcono = (i: number) => (i % 2 === 0 ? 'linear-gradient(135deg,#4F46E5,#06B6D4)' : 'linear-gradient(135deg,#06B6D4,#4F46E5)');
---

<section id="servicios" data-screen-label="Servicios" style="background:#F8FAFC; color:#0F172A; padding:96px 48px 140px; box-sizing:border-box;">
  <div style="max-width:1240px; margin:0 auto; display:flex; flex-direction:column; gap:48px;">
    <div data-fade="1" style="max-width:560px; display:flex; flex-direction:column; gap:12px;">
      <span style="color:#4F46E5; font-weight:700; font-size:14px; letter-spacing:1.5px; text-transform:uppercase;">{t.svcLabel}</span>
      <h2 style="margin:0; font-size:43px; font-weight:800; letter-spacing:-1.2px; line-height:1.12; text-wrap:balance; background:linear-gradient(90deg,#4F46E5,#06B6D4); -webkit-background-clip:text; background-clip:text; color:transparent;">{t.svcTitle}</h2>
    </div>
    <div style="display:flex; flex-direction:column; gap:24px;">
      <div class="svc-grid" data-tilt-grid>
        {servicios.map((s, i) => {
          const Etiqueta = s.enlacePortada ? 'a' : 'div';
          return (
            <Etiqueta
              href={s.enlacePortada ?? undefined}
              class:list={['tilt-card', 'tilt-card--light', s.enlacePortada && 'fc-indigo']}
              data-tilt-card
              style={estiloTarjeta + (s.enlacePortada ? ' color:#0F172A;' : '')}
            >
              <div style={`width:44px; height:44px; border-radius:12px; background:${fondoIcono(i)}; display:flex; align-items:center; justify-content:center;`}>
                {s.icono === 'circulo' && <div style="width:16px; height:16px; border-radius:50%; border:2.5px solid #fff;"></div>}
                {s.icono === 'ventana' && <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2" aria-hidden="true"><rect x="3" y="4" width="18" height="14" rx="2"></rect><line x1="3" y1="9" x2="21" y2="9"></line></svg>}
                {s.icono === 'pin' && <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2" stroke-linejoin="round" aria-hidden="true"><path d="M12 21s-6.5-5.6-6.5-10.5a6.5 6.5 0 0 1 13 0C18.5 15.4 12 21 12 21z"></path><circle cx="12" cy="10.5" r="2.3"></circle></svg>}
                {s.icono === 'escudo' && <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3l7 3v5.5c0 4.2-2.9 7.6-7 9-4.1-1.4-7-4.8-7-9V6l7-3z"></path><path d="M9 12l2.2 2.2L15.2 10"></path></svg>}
                {s.icono === 'rombo' && <div style="width:16px; height:16px; border:2.5px solid #fff; transform:rotate(45deg);"></div>}
                {s.icono === 'cuadrado' && <div style="width:16px; height:16px; border-radius:4px; border:2.5px solid #fff;"></div>}
              </div>
              <h3 style="margin:0; font-size:19px; font-weight:800;">{s.titulo}</h3>
              <p style="margin:0; font-size:15px; line-height:1.6; color:#475569;">{s.descripcion}</p>
              {s.enUso && (
                <p style="margin:auto 0 0; padding-top:4px; font-size:13px; line-height:1.5; color:#64748B;"><strong style="color:#4F46E5; font-weight:700;">{t.svcUsedIn}</strong> {s.enUso}</p>
              )}
            </Etiqueta>
          );
        })}
      </div>
      <p data-fade="1" style="margin:0; font-size:14px; line-height:1.6; color:#64748B;">{t.svcMore} <a class="hv-texto-cian" href="#complementarios" style="color:#4F46E5; font-weight:700;">{t.svcMoreLink}</a></p>
    </div>
  </div>
</section>
