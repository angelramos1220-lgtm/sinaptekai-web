---
// Sección "Casos de éxito". Datos: src/data/casos.ts (textos aprobados por el
// cliente: se muestran exactos) y src/data/testimonio.ts (null = no se dibuja).
import { textos as t } from '../data/textos';
import { casos } from '../data/casos';
import { testimonio } from '../data/testimonio';
import { waLink } from '../lib/whatsapp';
---

<section id="casos" data-screen-label="Casos de éxito" style="background:#F8FAFC; color:#0F172A; padding:96px 48px 140px; box-sizing:border-box;">
  <div style="max-width:1240px; margin:0 auto; display:flex; flex-direction:column; gap:56px;">
    <div data-fade="1" style="max-width:640px; display:flex; flex-direction:column; gap:12px;">
      <span style="color:#4F46E5; font-weight:700; font-size:14px; letter-spacing:1.5px; text-transform:uppercase;">{t.casosLabel}</span>
      <h2 style="margin:0; font-family:'Space Grotesk', sans-serif; font-size:38px; font-weight:800; letter-spacing:-1px; line-height:1.15; text-wrap:balance;">{t.casosTitle}</h2>
    </div>
    <div class="casos-grid" data-tilt-grid>
      {casos.map((caso) => (<Fragment>
        <div class="tilt-card tilt-card--light" data-tilt-card style="--hover-glow: rgba(79,70,229,0.18); border-radius:20px; padding:32px; display:flex; flex-direction:column; gap:16px; height:100%; box-sizing:border-box;">
            <div style="display:flex; flex-wrap:wrap; gap:5px;">
              {caso.chips.map((chip) => (<Fragment>
                <span style="display:inline-flex; align-items:center; background:#EEF2FF; color:#4338CA; font-size:11px; font-weight:700; padding:3px 8px; border-radius:999px; line-height:1.4; white-space:nowrap;">{chip}</span>
              </Fragment>))}
            </div>
            {caso.imagen && (<Fragment>
              <img src={caso.imagen} alt={caso.nombre} loading="lazy" decoding="async" style="width:100%; border-radius:14px; display:block; object-fit:cover; aspect-ratio:16/9;">
            </Fragment>)}
            <h3 style="margin:0; font-family:'Space Grotesk', sans-serif; font-size:22px; font-weight:800;">{caso.nombre}</h3>
            <div style="display:flex; flex-direction:column; gap:10px;">
              <p style="margin:0; font-size:15px; line-height:1.6; color:#475569;"><strong style="color:#0F172A;">{t.casoProblema}</strong> {caso.problema}</p>
              <p style="margin:0; font-size:15px; line-height:1.6; color:#475569;"><strong style="color:#0F172A;">{t.casoSolucion}</strong> {caso.solucion}</p>
              {caso.resultado && (<Fragment>
                <p style="margin:0; font-size:15px; line-height:1.6; color:#475569;"><strong style="color:#0F172A;">{t.casoResultado}</strong> {caso.resultado}</p>
              </Fragment>)}
            </div>
        </div>
      </Fragment>))}
    </div>
    {testimonio && (<Fragment>
      <figure data-fade="1" style="margin:0; align-self:center; width:100%; max-width:920px; box-sizing:border-box; padding:clamp(24px, 4vw, 44px); border-radius:24px; background:linear-gradient(135deg,#EEF2FF,#ECFEFF); border:1px solid #E0E7FF; display:flex; flex-direction:column; gap:18px;">
        <span aria-hidden="true" style="font-family:'Space Grotesk', sans-serif; font-size:72px; line-height:0.55; height:28px; font-weight:800; background:linear-gradient(90deg,#4F46E5,#06B6D4); -webkit-background-clip:text; background-clip:text; color:transparent;">“</span>
        <blockquote style="margin:0; font-family:'Space Grotesk', sans-serif; font-size:clamp(20px, 2.4vw, 28px); line-height:1.35; font-weight:700; letter-spacing:-0.4px; color:#0F172A; text-wrap:balance;">{testimonio.texto}</blockquote>
        <figcaption style="font-size:15px; line-height:1.5; color:#475569;"><strong style="color:#0F172A;">{testimonio.nombre}</strong>{testimonio.cargo && (<Fragment> · {testimonio.cargo}</Fragment>)}</figcaption>
      </figure>
    </Fragment>)}
    <div data-fade="1" style="display:flex; flex-direction:column; align-items:center; gap:16px; text-align:center; padding-top:16px;">
      <h3 style="margin:0; font-family:'Space Grotesk', sans-serif; font-size:26px; font-weight:800;">{t.casosCta}</h3>
      <a class="hv-wa fc-cian" href={waLink(t.casosWaMsg)} target="_blank" data-origen="caso" style="display:inline-flex; align-items:center; gap:8px; background:#25D366; color:#052E16; font-weight:700; font-size:15px; padding:14px 28px; border-radius:12px; min-height:48px; box-sizing:border-box;">
        <span style="width:8px; height:8px; border-radius:50%; background:#052E16; display:inline-block;"></span>
        {t.ctaWa}
      </a>
    </div>
  </div>
</section>
