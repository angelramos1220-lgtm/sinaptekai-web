---
// Tarjeta de un plan de diseño web.
import type { PlanWeb } from '../../data/planesWeb';
import Vinetas from '../Vinetas.astro';

interface Props {
  plan: PlanWeb;
  nivel?: 'h2' | 'h3';
}
const { plan, nivel: Titulo = 'h3' } = Astro.props;
---

<div class="tilt-card tarjeta-plan" data-tilt-card style={`--hover-glow: ${plan.resplandor};`}>
  <div class="icono-degradado">
    {plan.id === 'landing' && <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2" aria-hidden="true"><rect x="3" y="4" width="18" height="14" rx="2"></rect><line x1="3" y1="9" x2="21" y2="9"></line></svg>}
    {plan.id === 'corporativo' && <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="2"></rect><line x1="3" y1="9" x2="21" y2="9"></line><line x1="9" y1="21" x2="9" y2="9"></line></svg>}
    {plan.id === 'funcionalidades' && <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2" aria-hidden="true"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect><line x1="16" y1="2" x2="16" y2="6"></line><line x1="8" y1="2" x2="8" y2="6"></line><line x1="3" y1="10" x2="21" y2="10"></line></svg>}
    {plan.id === 'tienda' && <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2" aria-hidden="true"><circle cx="9" cy="21" r="1"></circle><circle cx="20" cy="21" r="1"></circle><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path></svg>}
  </div>
  <Titulo class="tarjeta-plan__nombre">{plan.nombre}</Titulo>
  <div class="tarjeta-plan__precio">
    <span class="tarjeta-plan__monto">{plan.precio}</span>
    <span class="tarjeta-plan__nota">{plan.notaPago}</span>
    <span class="tarjeta-plan__nota">{plan.mantenimiento}</span>
  </div>
  <Vinetas items={plan.incluye} />
</div>
