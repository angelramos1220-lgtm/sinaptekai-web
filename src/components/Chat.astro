---
// Chat flotante del sitio. Marcado y estilos portados tal cual del sitio anterior.
// La lógica está en src/scripts/chat.js; los datos, en src/data/chat.ts.
//
// NO cambiar el webhook, el formato del envío ni los id de los servicios
// (viajan en servicioElegido): el workflow de n8n depende de ellos.
import { serviciosChat, textosChat as tx } from '../data/chat';
import { negocio, integraciones, almacenamiento } from '../data/negocio';
import '../styles/chat.css';

const config = JSON.stringify({
  webhook: integraciones.webhookChat,
  whatsapp: negocio.whatsapp.numero,
  servicios: serviciosChat,
  textos: tx,
  claves: almacenamiento,
});
---

<div id="sk-chat-root" data-origen="flotante" data-config={config}>
  <button id="sk-launcher" type="button" aria-haspopup="dialog" aria-expanded="false" aria-controls="sk-panel" aria-label={tx.abrir}>
    <svg viewBox="0 0 100 100" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
      <line x1="50" y1="14" x2="50" y2="26" stroke="#fff" stroke-width="4" stroke-linecap="round"/>
      <circle cx="50" cy="10" r="5" fill="#A5F3FC"/>
      <rect x="20" y="26" width="60" height="48" rx="16" stroke="#fff" stroke-width="4"/>
      <circle cx="37" cy="49" r="6" fill="#A5F3FC"/>
      <circle cx="63" cy="49" r="6" fill="#fff"/>
      <line x1="37" y1="63" x2="63" y2="63" stroke="#fff" stroke-width="4" stroke-linecap="round"/>
      <line x1="10" y1="50" x2="20" y2="50" stroke="#A5F3FC" stroke-width="4" stroke-linecap="round"/>
      <line x1="80" y1="50" x2="90" y2="50" stroke="#A5F3FC" stroke-width="4" stroke-linecap="round"/>
    </svg>
  </button>
  <button id="sk-greet-bubble" type="button" hidden>{tx.burbujaSaludo}</button>

  <div id="sk-panel-wrap" hidden>
    <div id="sk-panel" role="dialog" aria-modal="true" aria-labelledby="sk-header-title">
      <div id="sk-header">
        <div>
          <div id="sk-header-title">{tx.titulo}</div>
          <div id="sk-header-sub">{tx.subtitulo}</div>
        </div>
        <div id="sk-header-actions">
          <a id="sk-header-wa" href="#" target="_blank" rel="noopener" aria-label={tx.escribirWhatsApp}>
            <svg width="20" height="20" viewBox="0 0 32 32" fill="currentColor" aria-hidden="true"><path d="M16.001 3C9.373 3 4 8.373 4 15c0 2.373.7 4.583 1.902 6.436L4 29l7.78-1.865A11.94 11.94 0 0 0 16.001 27C22.628 27 28 21.627 28 15S22.628 3 16.001 3zm6.72 17.06c-.285.803-1.41 1.47-2.318 1.66-.617.13-1.423.234-4.138-.888-3.472-1.436-5.706-4.94-5.878-5.17-.165-.23-1.39-1.85-1.39-3.53 0-1.68.865-2.5 1.172-2.84.307-.34.667-.425.89-.425.223 0 .446.002.64.012.207.01.485-.079.758.578.285.68.968 2.35 1.052 2.52.086.17.144.37.03.6-.114.23-.172.37-.34.57-.17.2-.357.446-.51.6-.17.17-.347.354-.15.694.198.34.883 1.457 1.897 2.36 1.303 1.163 2.4 1.523 2.74 1.694.34.17.54.144.74-.086.198-.23.85-.99 1.078-1.33.228-.34.456-.283.77-.17.313.114 1.99.94 2.33 1.11.34.17.567.256.65.4.084.144.084.83-.2 1.633z"/></svg>
          </a>
          <button id="sk-close" type="button" aria-label={tx.cerrar}>&times;</button>
        </div>
      </div>
      <div id="sk-log" role="log" aria-live="polite" aria-label={tx.conversacion}></div>
      <div id="sk-chips"></div>
      <form id="sk-form">
        <label for="sk-input" class="sk-sr-only">{tx.etiquetaCampo}</label>
        <input id="sk-input" type="text" autocomplete="off" placeholder={tx.placeholder}>
        <button type="submit" id="sk-send" aria-label={tx.enviar}>&#10148;</button>
      </form>
    </div>
  </div>
</div>

<script>
  import { iniciarChat } from '../scripts/chat.js';
  const raiz = document.getElementById('sk-chat-root');
  if (raiz) iniciarChat(JSON.parse(raiz.dataset.config || '{}'));
</script>
