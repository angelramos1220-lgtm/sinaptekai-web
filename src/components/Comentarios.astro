---
// Sección "Comentarios": no publica nada; abre WhatsApp con el comentario prellenado.
import { textos as t } from '../data/textos';
import { negocio } from '../data/negocio';
---

<section id="comentarios" data-screen-label="Comentarios" style="background:#070A12; color:#F1F5F9; padding:64px 48px 110px; box-sizing:border-box;">
  <div data-fade="1" style="max-width:640px; margin:0 auto; display:flex; flex-direction:column; gap:20px; align-items:center; text-align:center;">
    <div style="display:flex; flex-direction:column; gap:8px; align-items:center;">
      <h2 style="margin:0; font-size:26px; font-weight:800; letter-spacing:-0.5px;">{t.feedbackTitle}</h2>
      <p style="margin:0; font-size:15px; line-height:1.6; color:#94A3B8;">{t.feedbackSub}</p>
    </div>
    <form id="form-comentarios" data-whatsapp={negocio.whatsapp.numero} data-anonimo={t.feedbackAnonimo} style="width:100%; max-width:480px; display:flex; flex-direction:column; gap:12px; text-align:left; background:rgba(30,41,59,0.4); border:1px solid #1E293B; border-radius:18px; padding:24px; box-sizing:border-box;">
      <label style="display:flex; flex-direction:column; gap:6px; font-size:13px; font-weight:700; color:#CBD5E1;">{t.feedbackName}
        <input class="fc-campo" name="fbNombre" style="min-height:42px; border-radius:10px; border:1px solid #334155; background:#0F172A; color:#F1F5F9; padding:0 14px; font-family:inherit; font-size:14px; box-sizing:border-box;">
      </label>
      <label style="display:flex; flex-direction:column; gap:6px; font-size:13px; font-weight:700; color:#CBD5E1;">{t.feedbackMsg}
        <textarea class="fc-campo" name="fbComentario" required rows="3" style="border-radius:10px; border:1px solid #334155; background:#0F172A; color:#F1F5F9; padding:12px 14px; font-family:inherit; font-size:14px; resize:vertical; box-sizing:border-box;"></textarea>
      </label>
      <button class="hv-wa fc-cian" type="submit" style="min-height:44px; border:none; border-radius:11px; background:#25D366; color:#052E16; font-family:inherit; font-weight:800; font-size:14px; cursor:pointer; margin-top:4px;">{t.feedbackSend}</button>
    </form>
  </div>
</section>

<script>
  import { iniciarFormularioComentarios } from "../scripts/formularios-whatsapp";
  iniciarFormularioComentarios();
</script>
