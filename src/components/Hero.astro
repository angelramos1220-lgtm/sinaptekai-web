---
// Hero de la portada. El canvas dibuja la constelación y el diagrama de flujo
// (src/scripts/hero.js) con los nodos de src/data/flow.ts. El texto está en el HTML:
// sin JavaScript se ve todo menos la animación.
import { textos as t } from '../data/textos';
import { FLOW_NODES, FLOW_ROUTES } from '../data/flow';
import { waLink } from '../lib/whatsapp';

const waHref = waLink(t.waMsg);
const flow = JSON.stringify({ nodos: FLOW_NODES, rutas: FLOW_ROUTES });
---

<section id="inicio" class="hero-section" data-screen-label="Hero" style="position:relative; overflow:hidden; max-width:1240px; margin:0 auto; box-sizing:border-box;">
  <canvas id="hero-constellation" aria-hidden="true" data-flow={flow} style="position:absolute; inset:0; width:100%; height:100%; z-index:0; pointer-events:none; display:block;"></canvas>
  <div style="position:absolute; inset:0; background:radial-gradient(ellipse 60% 50% at 70% 30%, rgba(79,70,229,0.18), transparent 70%); pointer-events:none;"></div>
  <div class="hero-content" style="position:relative; max-width:680px; display:flex; flex-direction:column;">
    <span style="display:inline-flex; align-self:flex-start; align-items:center; gap:8px; border:1px solid rgba(6,182,212,0.35); color:#67E8F9; font-size:13px; font-weight:600; padding:6px 14px; border-radius:999px; letter-spacing:0.4px;">{t.badge}</span>
    <h1 style="margin:0; font-family:var(--fuente-titular); font-size:60px; line-height:1.06; font-weight:800; letter-spacing:-1.8px; text-wrap:balance;">{t.heroT1} <span style="background:linear-gradient(90deg,#818CF8,#22D3EE); -webkit-background-clip:text; background-clip:text; color:transparent;">{t.heroT2}</span></h1>
    <p style="margin:0; font-size:19px; line-height:1.6; color:#94A3B8; max-width:560px; text-wrap:pretty;">{t.heroSub}</p>
    <div style="display:flex; gap:14px; flex-wrap:wrap; margin-top:8px;">
      <a class="hv-indigo fc-indigo" href="#contacto" style="display:inline-flex; align-items:center; background:#4F46E5; color:#fff; font-weight:700; font-size:16px; padding:15px 28px; border-radius:12px; min-height:48px; box-sizing:border-box;">{t.ctaDemo}</a>
      <a class="hv-wa-suave fc-verde" href={waHref} target="_blank" data-origen="hero" style="display:inline-flex; align-items:center; gap:8px; background:transparent; border:1.5px solid #25D366; color:#4ADE80; font-weight:700; font-size:16px; padding:15px 28px; border-radius:12px; min-height:48px; box-sizing:border-box;">{t.ctaWa}</a>
    </div>
    <div class="hero-trust" style="display:flex; gap:12px; margin-top:24px; color:#94A3B8; font-size:14px; font-weight:600; flex-wrap:wrap;">
      <span>{t.trust1}</span><span>·</span><span>{t.trust2}</span><span>·</span><span>{t.trust3}</span>
    </div>
    <div id="hero-flow-spacer" class="hero-flow-spacer" aria-hidden="true"></div>
  </div>
</section>

<script>
  import { iniciarHero } from '../scripts/hero.js';
  const canvas = document.getElementById('hero-constellation');
  if (canvas) iniciarHero(JSON.parse(canvas.dataset.flow || '{"nodos":[],"rutas":[]}'));
</script>
