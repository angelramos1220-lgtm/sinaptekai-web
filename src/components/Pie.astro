---
// Footer del sitio: marca, servicios, enlaces, contacto, redes y páginas legales.
// Los enlaces salen de src/data/sitio.ts.
import { textos as t } from '../data/textos';
import { textosPaginas as tp } from '../data/textosPaginas';
import { negocio } from '../data/negocio';
import { enlacesServicios, enlacesPie, enlacesLegales } from '../data/sitio';
import { waLink } from '../lib/whatsapp';
import logo from '../assets/marca/logo.webp';

interface Props {
  /**
   * En las páginas internas el footer usa en móvil el mismo margen lateral que el
   * contenido. En la portada conserva el del sitio anterior (48 px), igual que sus secciones.
   */
  alineado?: boolean;
}
const { alineado = false } = Astro.props;
const waHref = waLink(t.waMsg);
---

<footer class:list={['pie', alineado && 'pie--alineado']} data-screen-label="Footer">
  <div class="pie__contenido">
    <div class="pie__columnas">
      <div class="pie__columna">
        <div class="pie__marca">
          <img src={logo.src} alt={negocio.nombre} width={logo.width} height={logo.height} loading="lazy" decoding="async">
          <span class="pie__nombre">Synaptek<span>AI</span></span>
        </div>
        <p class="pie__lema">{negocio.lema}</p>
      </div>
      <nav class="pie__columna" aria-label={tp.pieServicios}>
        <span class="pie__titulo">{tp.pieServicios}</span>
        {enlacesServicios.map((e) => <a href={e.href}>{e.texto}</a>)}
      </nav>
      <nav class="pie__columna" aria-label={tp.pieSitio}>
        <span class="pie__titulo">{tp.pieSitio}</span>
        {enlacesPie.map((e) => <a href={e.href}>{e.texto}</a>)}
      </nav>
      <div class="pie__columna">
        <span class="pie__titulo">{t.footContact}</span>
        <a href={`mailto:${negocio.correo}`}>{negocio.correo}</a>
        <a href={waHref} target="_blank" rel="noopener" data-origen="footer">
          <span class="pie__icono-wa" aria-hidden="true"></span>
          {t.footSocialWa} {negocio.whatsapp.visible}
        </a>
        <span class="pie__dato">{negocio.dominio}</span>
      </div>
      <div class="pie__columna">
        <span class="pie__titulo">{t.footSocial}</span>
        <a href={negocio.redes.facebook} target="_blank" rel="noopener">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"></path></svg>
          {t.footSocialFb}
        </a>
        <a href={negocio.redes.instagram} target="_blank" rel="noopener">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line></svg>
          {t.footSocialIg}
        </a>
      </div>
    </div>
    <div class="pie__base">
      <span>{t.rights}</span>
      <div class="pie__legales">
        {enlacesLegales.map((e) => <a href={e.href}>{e.texto}</a>)}
        <span>{negocio.dominio}</span>
      </div>
    </div>
  </div>
</footer>
