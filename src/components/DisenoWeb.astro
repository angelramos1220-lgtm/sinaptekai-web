---
// Sección "Diseño de Páginas Web": 4 planes y el banner "Renueva tu Página Web".
// Datos: src/data/planesWeb.ts (los montos salen de src/data/precios.ts).
import { textos as t } from '../data/textos';
import { planesWeb, renuevaWeb } from '../data/planesWeb';
import { waLink } from '../lib/whatsapp';
---

<section id="diseno-web" data-screen-label="Diseño de Páginas Web" style="background:#0B0F19; color:#F1F5F9; padding:96px 48px 140px; box-sizing:border-box; position:relative; overflow:hidden;">
  <div style="position:absolute; inset:0; background:radial-gradient(ellipse 55% 55% at 15% 15%, rgba(79,70,229,0.14), transparent 70%); pointer-events:none;"></div>
  <div style="max-width:1240px; margin:0 auto; display:flex; flex-direction:column; gap:48px; position:relative;">
    <div data-fade="1" style="max-width:640px; display:flex; flex-direction:column; gap:12px;">
      <span style="color:#22D3EE; font-weight:700; font-size:14px; letter-spacing:1.5px; text-transform:uppercase;">{t.webLabel}</span>
      <h2 style="margin:0; font-family:'Space Grotesk', sans-serif; font-size:38px; font-weight:700; letter-spacing:-1px; line-height:1.15; text-wrap:balance;">{t.webTitle}</h2>
      <p style="margin:0; font-size:16px; line-height:1.6; color:#94A3B8;">{t.webSub}</p>
    </div>
    <div class="web-grid" data-tilt-grid>
      {planesWeb.map((plan) => (<Fragment>
        <div class="tilt-card" data-tilt-card style={`--hover-glow: ${plan.resplandor}; border-radius:20px; padding:28px; display:flex; flex-direction:column; gap:16px; box-sizing:border-box;`}>
          <div style="width:44px; height:44px; border-radius:12px; background:linear-gradient(135deg,#4F46E5,#06B6D4); display:flex; align-items:center; justify-content:center; flex-shrink:0;">
            {plan.id === 'landing' && (<Fragment>
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2" aria-hidden="true"><rect x="3" y="4" width="18" height="14" rx="2"></rect><line x1="3" y1="9" x2="21" y2="9"></line></svg>
            </Fragment>)}
            {plan.id === 'corporativo' && (<Fragment>
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="2"></rect><line x1="3" y1="9" x2="21" y2="9"></line><line x1="9" y1="21" x2="9" y2="9"></line></svg>
            </Fragment>)}
            {plan.id === 'funcionalidades' && (<Fragment>
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2" aria-hidden="true"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect><line x1="16" y1="2" x2="16" y2="6"></line><line x1="8" y1="2" x2="8" y2="6"></line><line x1="3" y1="10" x2="21" y2="10"></line></svg>
            </Fragment>)}
            {plan.id === 'tienda' && (<Fragment>
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2" aria-hidden="true"><circle cx="9" cy="21" r="1"></circle><circle cx="20" cy="21" r="1"></circle><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path></svg>
            </Fragment>)}
          </div>
          <h3 style="margin:0; font-family:'Space Grotesk', sans-serif; font-size:19px; font-weight:700;">{plan.nombre}</h3>
          <div style="display:flex; flex-direction:column; gap:3px;">
            <span style="font-size:21px; font-weight:800; letter-spacing:-0.3px;">{plan.precio}</span>
            <span style="font-size:12px; color:#94A3B8; font-weight:600;">{plan.notaPago}</span>
            <span style="font-size:12px; color:#94A3B8; font-weight:600;">{plan.mantenimiento}</span>
          </div>
          <div style="display:flex; flex-direction:column; gap:8px; margin-top:4px;">
            {plan.incluye.map((inc) => (<Fragment>
              <div style="display:flex; gap:10px; align-items:flex-start;">
                <span style="width:16px; height:16px; border-radius:50%; background:rgba(79,70,229,0.18); flex-shrink:0; margin-top:2px; display:flex; align-items:center; justify-content:center;"><span style="width:5px; height:5px; border-radius:50%; background:#818CF8; display:block;"></span></span>
                <span style="font-size:14px; line-height:1.5; color:#CBD5E1;">{inc}</span>
              </div>
            </Fragment>))}
          </div>
        </div>
      </Fragment>))}
      <div class="tilt-card tilt-card--pink promo-banner" data-tilt-card data-tilt-max="1.5" style="position:relative; padding:28px; border-radius:20px; box-sizing:border-box;">
        <span style="position:absolute; top:-13px; left:28px; background:#EC4899; color:#4A0A2E; font-size:12px; font-weight:800; padding:5px 14px; border-radius:999px; letter-spacing:0.3px;">{renuevaWeb.insignia}</span>
        <div class="promo-main" style="display:flex; flex-direction:column; gap:16px;">
          <div style="width:44px; height:44px; border-radius:12px; background:linear-gradient(135deg,#EC4899,#F472B6); display:flex; align-items:center; justify-content:center; flex-shrink:0; font-size:20px;">🔄</div>
          <h3 style="margin:0; font-family:'Space Grotesk', sans-serif; font-size:19px; font-weight:700;">{renuevaWeb.nombre}</h3>
          <p style="margin:0; font-size:13px; line-height:1.5; color:#94A3B8;">{renuevaWeb.descripcion}</p>
        </div>
        <div class="promo-price" style="display:flex; flex-direction:column; gap:3px;">
          <span style="font-size:21px; font-weight:800; letter-spacing:-0.3px;">{renuevaWeb.precio}</span>
          <span style="font-size:12px; color:#94A3B8; font-weight:600;">{renuevaWeb.notaPago}</span>
          <span style="font-size:12px; line-height:1.5; color:#94A3B8; margin-top:4px;">{renuevaWeb.notaHosting}</span>
        </div>
        <div class="promo-list" style="display:flex; flex-direction:column; gap:8px;">
          <div style="display:flex; gap:10px; align-items:flex-start;"><span style="width:16px; height:16px; border-radius:50%; background:rgba(244,114,182,0.18); flex-shrink:0; margin-top:2px; display:flex; align-items:center; justify-content:center;"><span style="width:5px; height:5px; border-radius:50%; background:#EC4899; display:block;"></span></span><span style="font-size:14px; line-height:1.5; color:#CBD5E1;">{renuevaWeb.vinetas[0]}</span></div>
          <div style="display:flex; gap:10px; align-items:flex-start;"><span style="width:16px; height:16px; border-radius:50%; background:rgba(244,114,182,0.18); flex-shrink:0; margin-top:2px; display:flex; align-items:center; justify-content:center;"><span style="width:5px; height:5px; border-radius:50%; background:#EC4899; display:block;"></span></span><span style="font-size:14px; line-height:1.5; color:#CBD5E1;">{renuevaWeb.vinetas[1]}</span></div>
          <div style="display:flex; gap:10px; align-items:flex-start;"><span style="width:16px; height:16px; border-radius:50%; background:rgba(244,114,182,0.18); flex-shrink:0; margin-top:2px; display:flex; align-items:center; justify-content:center;"><span style="width:5px; height:5px; border-radius:50%; background:#EC4899; display:block;"></span></span><span style="font-size:14px; line-height:1.5; color:#CBD5E1;">{renuevaWeb.vinetas[2]}</span></div>
          <div style="display:flex; gap:10px; align-items:flex-start;"><span style="width:16px; height:16px; border-radius:50%; background:rgba(244,114,182,0.18); flex-shrink:0; margin-top:2px; display:flex; align-items:center; justify-content:center;"><span style="width:5px; height:5px; border-radius:50%; background:#EC4899; display:block;"></span></span><span style="font-size:14px; line-height:1.5; color:#CBD5E1;">{renuevaWeb.vinetas[3]}</span></div>
        </div>
        <a class="promo-cta hv-brillo fc-blanco" href={waLink(renuevaWeb.mensajeWhatsApp)} target="_blank" data-origen={renuevaWeb.origen} style="display:inline-flex; align-items:center; justify-content:center; min-height:44px; padding:0 20px; border-radius:11px; background:#EC4899; color:#4A0A2E; font-weight:700; font-size:14px; text-align:center;">{renuevaWeb.boton}</a>
      </div>
    </div>
    <div data-fade="1" style="background:rgba(79,70,229,0.08); border:1px solid rgba(79,70,229,0.25); border-radius:20px; padding:32px 40px; display:flex; flex-wrap:wrap; align-items:center; justify-content:space-between; gap:20px;">
      <p style="margin:0; font-size:18px; font-weight:700; color:#F1F5F9;">{t.webCtaText}</p>
      <a class="hv-wa fc-cian" href={waLink(t.webWaMsg)} target="_blank" data-origen="diseno-web" style="display:inline-flex; align-items:center; gap:8px; background:#25D366; color:#052E16; font-weight:700; font-size:15px; padding:14px 26px; border-radius:12px; min-height:48px; box-sizing:border-box; white-space:nowrap;">
        <span style="width:8px; height:8px; border-radius:50%; background:#052E16; display:inline-block;"></span>
        {t.webCtaBtn}
      </a>
    </div>
  </div>
</section>
