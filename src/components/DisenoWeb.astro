---
// Sección "Diseño de Páginas Web": 4 planes y el banner "Renueva tu Página Web".
// Datos: src/data/planesWeb.ts (los montos salen de src/data/precios.ts).
import { textos as t } from '../data/textos';
import { planesWeb } from '../data/planesWeb';
import TarjetaPlanWeb from './tarjetas/TarjetaPlanWeb.astro';
import BannerRenueva from './tarjetas/BannerRenueva.astro';
import { waLink } from '../lib/whatsapp';
---

<section id="diseno-web" data-screen-label="Diseño de Páginas Web" style="background:#0B0F19; color:#F1F5F9; padding:96px var(--margen-lateral) 140px; box-sizing:border-box; position:relative; overflow:hidden;">
  <div style="position:absolute; inset:0; background:radial-gradient(ellipse 55% 55% at 15% 15%, rgba(79,70,229,0.14), transparent 70%); pointer-events:none;"></div>
  <div style="max-width:1240px; margin:0 auto; display:flex; flex-direction:column; gap:48px; position:relative;">
    <div data-fade="1" style="max-width:640px; display:flex; flex-direction:column; gap:12px;">
      <span style="color:#22D3EE; font-weight:700; font-size:14px; letter-spacing:1.5px; text-transform:uppercase;">{t.webLabel}</span>
      <h2 style="margin:0; font-family:'Space Grotesk', sans-serif; font-size:38px; font-weight:700; letter-spacing:-1px; line-height:1.15; text-wrap:balance;">{t.webTitle}</h2>
      <p style="margin:0; font-size:16px; line-height:1.6; color:#94A3B8;">{t.webSub}</p>
    </div>
    <div class="web-grid" data-tilt-grid>
      {planesWeb.map((plan) => <TarjetaPlanWeb plan={plan} />)}
      <BannerRenueva />
    </div>
    <div data-fade="1" style="background:rgba(79,70,229,0.08); border:1px solid rgba(79,70,229,0.25); border-radius:20px; padding:32px 40px; display:flex; flex-wrap:wrap; align-items:center; justify-content:space-between; gap:20px;">
      <p style="margin:0; font-size:18px; font-weight:700; color:#F1F5F9;">{t.webCtaText}</p>
      <a class="hv-wa fc-cian" href={waLink(t.webWaMsg)} target="_blank" data-origen="diseno-web" style="display:inline-flex; align-items:center; gap:8px; background:#25D366; color:#052E16; font-weight:700; font-size:15px; padding:14px 26px; border-radius:12px; min-height:48px; box-sizing:border-box; white-space:nowrap;">
        <span style="width:8px; height:8px; border-radius:50%; background:#052E16; display:inline-block;"></span>
        {t.webCtaBtn}
      </a>
    </div>
  </div>
</section>
