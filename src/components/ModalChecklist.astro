---
// Popup del checklist ("Antes de irte, llévate esto"). Se abre al llegar al 70 % del
// scroll, una vez por navegador. La lógica y el envío están en src/scripts/leads.ts.
import { textos as t } from '../data/textos';
import { integraciones, almacenamiento } from '../data/negocio';

// Lo que necesita el script para enviar los dos formularios del checklist.
const config = JSON.stringify({
  webhook: integraciones.webhookChecklist,
  paginaGracias: integraciones.paginaGracias,
  clavePopup: almacenamiento.popupMostrado,
  textos: {
    enviando: t.leadSending,
    errorGenerico: t.leadErrorGeneric,
    errorNombre: t.leadErrorNombre,
    errorEmailVacio: t.leadErrorEmailVacio,
    errorEmailFormato: t.leadErrorEmailFormato,
    errorNegocio: t.leadErrorNegocio,
  },
});
---

<div id="lead-modal-overlay" data-config={config} style={`display:none; position:fixed; inset:0; background:rgba(11,15,25,0.72); align-items:center; justify-content:center; padding:20px; box-sizing:border-box; z-index:200;`}>
  <div id="lead-modal" role="dialog" aria-modal="true" aria-labelledby="lead-modal-title" style="position:relative; width:100%; max-width:440px; max-height:90vh; overflow-y:auto; background:#0F172A; border:1px solid #1E293B; border-radius:20px; padding:32px; box-sizing:border-box; display:flex; flex-direction:column; gap:16px;">
    <button class="hv-cerrar fc-cian-fino" id="lead-modal-close" type="button" aria-label={t.modalClose} style="position:absolute; top:16px; right:16px; width:36px; height:36px; border-radius:50%; border:none; background:rgba(255,255,255,0.06); color:#94A3B8; font-size:18px; cursor:pointer; display:flex; align-items:center; justify-content:center;">✕</button>
    <span style="color:#22D3EE; font-weight:700; font-size:13px; letter-spacing:1.5px; text-transform:uppercase;">{t.modalEyebrow}</span>
    <h2 id="lead-modal-title" style="margin:0; font-size:24px; font-weight:800; letter-spacing:-0.5px; line-height:1.2; color:#F1F5F9;">{t.modalTitle}</h2>
    <p style="margin:0; font-size:14px; line-height:1.6; color:#94A3B8;">{t.modalDesc}</p>
    <form data-lead-form="" data-lead-source="modal" novalidate style="display:flex; flex-direction:column; gap:12px;">
      <label style="display:flex; flex-direction:column; gap:6px; font-size:13px; font-weight:700; color:#CBD5E1;">{t.leadNombre}
        <input class="fc-campo" name="nombre" type="text" autocomplete="name" aria-describedby="lead-modal-error-nombre" style="min-height:44px; border-radius:10px; border:1px solid #334155; background:#0F172A; color:#F1F5F9; padding:0 14px; font-family:inherit; font-size:14px; box-sizing:border-box;">
        <span id="lead-modal-error-nombre" data-error-for="nombre" role="alert" style="display:none; font-size:12px; color:#F87171; font-weight:600;"></span>
      </label>
      <label style="display:flex; flex-direction:column; gap:6px; font-size:13px; font-weight:700; color:#CBD5E1;">{t.leadEmail}
        <input class="fc-campo" name="email" type="email" autocomplete="email" aria-describedby="lead-modal-error-email" style="min-height:44px; border-radius:10px; border:1px solid #334155; background:#0F172A; color:#F1F5F9; padding:0 14px; font-family:inherit; font-size:14px; box-sizing:border-box;">
        <span id="lead-modal-error-email" data-error-for="email" role="alert" style="display:none; font-size:12px; color:#F87171; font-weight:600;"></span>
      </label>
      <label style="display:flex; flex-direction:column; gap:6px; font-size:13px; font-weight:700; color:#CBD5E1;">{t.leadNegocio}
        <input class="fc-campo" name="negocio" type="text" autocomplete="organization" aria-describedby="lead-modal-error-negocio" style="min-height:44px; border-radius:10px; border:1px solid #334155; background:#0F172A; color:#F1F5F9; padding:0 14px; font-family:inherit; font-size:14px; box-sizing:border-box;">
        <span id="lead-modal-error-negocio" data-error-for="negocio" role="alert" style="display:none; font-size:12px; color:#F87171; font-weight:600;"></span>
      </label>
      <button class="hv-indigo fc-indigo" type="submit" style="min-height:46px; border:none; border-radius:12px; background:#4F46E5; color:#fff; font-family:inherit; font-weight:800; font-size:15px; cursor:pointer; margin-top:4px;">{t.modalCta}</button>
      <p data-lead-status="" role="alert" style="display:none; margin:0; font-size:12px; color:#F87171; font-weight:600;"></p>
    </form>
  </div>
</div>

<script>
  import { iniciarLeads } from '../scripts/leads';
  iniciarLeads();
</script>
