---
// Sección "Contacto": botón de WhatsApp, correo y formulario que abre WhatsApp
// con el mensaje prellenado (no envía nada a ningún servidor).
import { textos as t } from '../data/textos';
import { negocio } from '../data/negocio';
import { waLink } from '../lib/whatsapp';

const waHref = waLink(t.waMsg);
---

<section id="contacto" data-screen-label="Contacto" style="background:#0B0F19; color:#F1F5F9; padding:96px var(--margen-lateral) 140px; box-sizing:border-box; position:relative; overflow:hidden;">
  <div style="position:absolute; inset:0; background:radial-gradient(ellipse 60% 60% at 50% 0%, rgba(79,70,229,0.16), transparent 70%); pointer-events:none;"></div>
  <div data-fade="1" style="max-width:880px; margin:0 auto; display:flex; flex-direction:column; gap:40px; position:relative; align-items:center; text-align:center;">
    <div style="display:flex; flex-direction:column; gap:14px; align-items:center;">
      <h2 style="margin:0; font-size:42px; font-weight:800; letter-spacing:-1.2px; line-height:1.12; text-wrap:balance;">{t.ctaTitle}</h2>
      <p style="margin:0; font-size:18px; line-height:1.6; color:#94A3B8; max-width:560px; text-wrap:pretty;">{t.ctaSub}</p>
    </div>
    <a class="hv-wa-sube fc-cian-amplio" href={waHref} target="_blank" data-origen="contacto" style="display:inline-flex; align-items:center; gap:10px; background:#25D366; color:#052E16; font-weight:800; font-size:18px; padding:18px 36px; border-radius:14px; min-height:52px; box-sizing:border-box;">
      <span style="width:10px; height:10px; border-radius:50%; background:#052E16; display:inline-block;"></span>
      {t.ctaWaBig}
    </a>
    <p style="margin:0; font-size:15px; color:#94A3B8;">{t.orEmail} <a class="hv-texto-cian-claro" href={`mailto:${negocio.correo}`} style="color:#22D3EE; font-weight:700;">{negocio.correo}</a></p>
    <form id="form-contacto" data-whatsapp={negocio.whatsapp.numero} data-mensaje-por-defecto={t.formMsgPorDefecto} style="width:100%; max-width:520px; display:flex; flex-direction:column; gap:14px; text-align:left; background:rgba(30,41,59,0.4); border:1px solid #1E293B; border-radius:20px; padding:32px; box-sizing:border-box;">
      <label style="display:flex; flex-direction:column; gap:6px; font-size:14px; font-weight:700; color:#CBD5E1;">{t.formName}
        <input class="fc-campo" name="nombre" required style="min-height:44px; border-radius:10px; border:1px solid #334155; background:#0F172A; color:#F1F5F9; padding:0 14px; font-family:inherit; font-size:15px; box-sizing:border-box;">
      </label>
      <label style="display:flex; flex-direction:column; gap:6px; font-size:14px; font-weight:700; color:#CBD5E1;">{t.formBiz}
        <input class="fc-campo" name="negocio" style="min-height:44px; border-radius:10px; border:1px solid #334155; background:#0F172A; color:#F1F5F9; padding:0 14px; font-family:inherit; font-size:15px; box-sizing:border-box;">
      </label>
      <label style="display:flex; flex-direction:column; gap:6px; font-size:14px; font-weight:700; color:#CBD5E1;">{t.formMsg}
        <textarea class="fc-campo" name="mensaje" rows="3" style="border-radius:10px; border:1px solid #334155; background:#0F172A; color:#F1F5F9; padding:12px 14px; font-family:inherit; font-size:15px; resize:vertical; box-sizing:border-box;"></textarea>
      </label>
      <button class="hv-indigo fc-indigo" type="submit" style="min-height:48px; border:none; border-radius:12px; background:#4F46E5; color:#fff; font-family:inherit; font-weight:800; font-size:16px; cursor:pointer; margin-top:6px;">{t.formSend}</button>
    </form>
  </div>
</section>

<script>
  import { iniciarFormularioContacto } from "../scripts/formulario-contacto";
  iniciarFormularioContacto();
</script>
